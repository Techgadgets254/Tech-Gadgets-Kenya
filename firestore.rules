rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Primitives and Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'techgadgetsk@gmail.com' || 
        request.auth.token.email == 'admin@techgadgetskenya.co.ke' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data['admin-claims'] == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data['admin-claims'] == 'admin'
        ))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Rules for Entities ---

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.brand is string && data.brand.size() > 0 && data.brand.size() <= 100
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.price is number && data.price >= 0
        && (data.stock is int || data.stock is number) && data.stock >= 0
        && (!data.keys().hasAll(['description']) || (data.description is string && data.description.size() <= 3000))
        && (!data.keys().hasAll(['image']) || (data.image is string && data.image.size() <= 15000000))
        && (!data.keys().hasAll(['sku']) || (data.sku is string && data.sku.size() <= 100))
        && (!data.keys().hasAll(['deleted']) || data.deleted is bool);
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200
        && data.customerEmail is string && data.customerEmail.size() > 0 && data.customerEmail.size() <= 300
        && data.shippingAddress is string && data.shippingAddress.size() > 0 && data.shippingAddress.size() <= 2000
        && data.totalAmount is number && data.totalAmount >= 0
        && data.mpesaPhone is string && data.mpesaPhone.size() <= 30
        && data.paymentStatus is string && (data.paymentStatus == 'Pending' || data.paymentStatus == 'Paid' || data.paymentStatus == 'Failed')
        && data.shippingStatus is string && (data.shippingStatus == 'Processing' || data.shippingStatus == 'Shipped' || data.shippingStatus == 'Delivered')
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100;
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() <= 300
        && data.name is string && data.name.size() <= 200
        && data.role is string && (data.role == 'customer' || data.role == 'admin')
        && (!data.keys().hasAll(['wishlist']) || data.wishlist is list)
        && (!data.keys().hasAll(['admin-claims']) || data['admin-claims'] is bool || data['admin-claims'] is string);
    }

    function isValidTransactionFeedback(data) {
      return data.orderId is string && data.orderId.size() > 0
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 200
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 2000
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidCompanyProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.taxPin is string && data.taxPin.size() > 0 && data.taxPin.size() <= 100
        && (!data.keys().hasAll(['logoUrl']) || data.logoUrl is string)
        && (!data.keys().hasAll(['address']) || (data.address is string && data.address.size() <= 500))
        && (!data.keys().hasAll(['email']) || (data.email is string && data.email.size() <= 300))
        && (!data.keys().hasAll(['phone']) || (data.phone is string && data.phone.size() <= 100));
    }

    function isValidNewsletter(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() <= 300
        && data.subscribedAt is string && data.subscribedAt.size() <= 100;
    }

    function isValidPriceAlert(data) {
      return data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
        && data.productName is string && data.productName.size() > 0 && data.productName.size() <= 300
        && data.email is string && data.email.size() > 0 && data.email.size() <= 300
        && data.targetPrice is number && data.targetPrice > 0
        && data.currentPrice is number && data.currentPrice > 0
        && data.createdAt is string && data.createdAt.size() <= 100
        && (!data.keys().hasAll(['whatsapp']) || (data.whatsapp is string && data.whatsapp.size() <= 100));
    }

    function isValidTrash(data) {
      return data.originalId is string && data.originalId.size() > 0
        && data.deletedAt is string && data.deletedAt.size() <= 100
        && data.productData is map;
    }

    function isValidActivityLog(data) {
      return data.type is string && (data.type == 'page_view' || data.type == 'search')
        && data.target is string && data.target.size() > 0 && data.target.size() <= 300
        && (!data.keys().hasAll(['userId']) || (data.userId is string && data.userId.size() <= 128))
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidReview(data) {
      return data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 200
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidAuditLog(data) {
      return data.action is string && data.action.size() > 0 && data.action.size() <= 100
        && data.details is string && data.details.size() > 0 && data.details.size() <= 1000
        && data.adminEmail is string && data.adminEmail.size() > 0 && data.adminEmail.size() <= 300
        && (!data.keys().hasAll(['adminUid']) || (data.adminUid is string && data.adminUid.size() <= 128))
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidAuthEvent(data) {
      return data.eventType is string && data.eventType.size() > 0 && data.eventType.size() <= 60
        && data.status is string && data.status.size() > 0 && data.status.size() <= 30
        && data.email is string && data.email.size() <= 300
        && (!data.keys().hasAll(['userId']) || (data.userId is string && data.userId.size() <= 128))
        && (!data.keys().hasAll(['ip']) || (data.ip is string && data.ip.size() <= 64))
        && (!data.keys().hasAll(['errorMessage']) || (data.errorMessage is string && data.errorMessage.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidSeoMetadata(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
        && data.keywords is string && data.keywords.size() <= 1000
        && data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    function isValidSearchQuery(data) {
      return data.query is string && data.query.size() > 0 && data.query.size() <= 300
        && (!data.keys().hasAll(['userId']) || (data.userId is string && data.userId.size() <= 128))
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    // --- Collection Routes ---

    // Products collection: anybody can browse (read/list), only admins can edit products
    match /products/{productId} {
      allow read, list: if true;
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Orders collection:
    // - Create: Must be signed in, and order userId must be request.auth.uid
    // - Get/Read: Must be owner of the order or Admin
    // - List: Must be Admin OR query filtered with where("userId", "==", request.auth.uid)
    // - Update: Admins can update any field. Customers can ONLY submit M-Pesa tracking codes if paymentStatus is Pending.
    match /orders/{orderId} {
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() && isValidOrder(incoming())
      ) || (
        // Client-side self checkout updates (e.g. entering transaction receipt reference)
        resource.data.userId == request.auth.uid && 
        isValidOrder(incoming()) &&
        existing().paymentStatus == 'Pending' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['receiptNo', 'mpesaPhone', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, list, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Users collection:
    // - Users can read and write their own documents.
    // - Prevent escalating own privileges to "admin" on create.
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (
        incoming().role == 'customer' || isAdmin()
      );
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (
        (incoming().role == existing().role) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Newsletters collection:
    // - Anyone can subscribe to newsletters (create).
    // - Only admins can read/list/update/delete the entire collection tracking.
    match /newsletters/{newsletterId} {
      allow create: if isValidNewsletter(incoming());
      allow read, list, update, delete: if isAdmin();
    }

    // Price Alerts collection:
    // - Anyone can request a price alert (create).
    // - Only admins can read/list/update/delete the price alerts.
    match /price_alerts/{alertId} {
      allow create: if isValidPriceAlert(incoming());
      allow read, list, update, delete: if isAdmin();
    }

    // Trash collection:
    // - Only admins can read, list, create, update, or delete soft-deleted records.
    match /trash/{trashId} {
      allow create: if isAdmin() && isValidTrash(incoming());
      allow read, list, update, delete: if isAdmin();
    }

    // Affiliates collection:
    // - Anyone can read/list affiliate codes to validate them.
    // - Only admins can create, update, or delete them.
    match /affiliates/{affiliateId} {
      allow read, list, get: if true;
      allow create, update, delete: if isAdmin();
    }

    // Activity Logs: anybody can log activity (views/searches), only admins can read and review them
    match /activity_logs/{logId} {
      allow create: if isValidActivityLog(incoming());
      allow read, list, delete: if isAdmin();
    }

    // Reviews collection:
    // - Anyone can see product reviews (read/list)
    // - Authenticated users can write a review for a product with their userId
    // - Admins can delete or moderate reviews
    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isSignedIn() && isValidReview(incoming()) && incoming().userId == request.auth.uid;
      allow delete, update: if isAdmin();
    }

    // Transaction Feedback collection:
    // - Anyone can read review aggregations (read/list)
    // - Authenticated users can write transaction experience updates
    match /transaction_feedback/{feedbackId} {
      allow read, list, get: if true;
      allow create: if isSignedIn() && isValidTransactionFeedback(incoming()) && incoming().userId == request.auth.uid;
      allow delete, update: if isAdmin();
    }

    // Company Profile settings collection:
    // - Readable by anyone (to populate printable invoices and PDFs)
    // - Only editable by administrators
    match /company_profile/{profileId} {
      allow read, list, get: if true;
      allow create, update: if isAdmin() && isValidCompanyProfile(incoming());
      allow delete: if isAdmin();
    }

    // Audit logs:
    // - Secure and indelible. Only admin can retrieve and record audit logs.
    match /audit_logs/{logId} {
      allow create: if isAdmin() && isValidAuditLog(incoming());
      allow read, list: if isAdmin();
      allow update, delete: if false;
    }

    // User Authentication Events Logs collection (Auditing and Security Monitor)
    match /auth_events/{eventId} {
      allow create: if isValidAuthEvent(incoming());
      allow read, list, delete: if isAdmin();
      allow update: if false;
    }

    // SEO Site-wide Metadata settings:
    // - Anyone can read this (to set head tags in real-time)
    // - Only administrators can write/update this
    match /seo_metadata/{docId} {
      allow read, get, list: if true;
      allow create, update: if isAdmin() && isValidSeoMetadata(incoming());
      allow delete: if isAdmin();
    }

    // Search Queries logs collection:
    // - Anyone can log their searches (create)
    // - Only administrators can read or list them
    match /search_queries/{queryId} {
      allow create: if isValidSearchQuery(incoming());
      allow read, list, delete: if isAdmin();
    }
  }
}
